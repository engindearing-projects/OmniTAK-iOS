// Copy this file to `Config.xcconfig` (gitignored) and fill in real values.
// The committed Config.base.xcconfig is the baseConfigurationReference for
// Debug + Release and optionally `#include?`s Config.xcconfig, so your values
// here override the empty defaults and get substituted into Info.plist at
// build time via `$(SETTING_NAME)` references.
//
// You do NOT need this file just to build — a fresh checkout compiles with the
// empty defaults (the Mapbox basemap simply won't render tiles without a token).
//
// New devs / CI: see CONTRIBUTING.md "Mapbox token" section.

// Mapbox public access token (pk.*). Bundle-id restricted in Mapbox console.
// Get yours at https://account.mapbox.com/access-tokens/
MBX_ACCESS_TOKEN = pk.REPLACE_ME

// Cesium Ion access token for the 3D globe's world terrain / Ion assets.
// Get yours at https://ion.cesium.com/tokens — scope it to the minimum
// assets needed. Without it the 3D globe still renders (no Ion terrain).
CESIUM_ION_TOKEN = REPLACE_ME

// Optional: default password used when extracting .p12 from imported TAK
// data packages. Most public TAK servers use the well-known default "atakatak".
// Leave blank to require explicit password every time.
DEFAULT_P12_PASSWORD =

// Ditto peer-to-peer mesh — https://portal.ditto.live
//
// With these set, OmniTAK devices running the same database ID discover each
// other over Bluetooth LE, peer-to-peer Wi-Fi and LAN and sync CoT directly, no
// TAK server required. Leave blank and the mesh stays off entirely.
//
// The portal shows the URL without a scheme; include https:// here.
DITTO_DATABASE_ID =
DITTO_URL = https://REPLACE_ME.cloud.dittolive.app

// Development ("playground") token. This is a DEVELOPMENT credential — it
// grants full read/write to the database and it EXPIRES, which means a device
// that has been offline past expiry stops syncing. Fine for testing and demos;
// swap for a production auth provider before shipping units to anyone.
DITTO_TOKEN =

// --- Shipping mode: shared key, no cloud, nothing expires ---------------
// Set BOTH of these and they win over DITTO_TOKEN above. Peers authenticate
// each other with certificates signed by this key, so devices that have never
// had a signal still mesh. The offline license token comes from Ditto
// (support@ditto.com) — it is not self-serve.
//
// Treat DITTO_SHARED_KEY like a private key: anyone holding it can join the
// mesh and read everything on it, and revoking one device means rotating it
// for everybody.
DITTO_SHARED_KEY =
DITTO_OFFLINE_LICENSE =
